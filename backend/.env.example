# ─────────────────────────────────────────────────────────────
# MNM Fashion — Backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (desktop + PWA).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (source of truth for all stock/financial records)
MONGODB_URI=mongodb://127.0.0.1:27017/mnm_fashion

# Auth
# Generate strong secrets, e.g.  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Public app URL (used to build customer-facing /bill/<token> links in messages)
PUBLIC_APP_URL=http://localhost:5173

# ── Object storage for invoice PDFs ──────────────────────────
# STORAGE_DRIVER = "s3" (Amazon S3 / MinIO / R2 / any S3-compatible)
#                | "local" (filesystem fallback for local dev — NOT for production)
STORAGE_DRIVER=local
# Local driver only:
LOCAL_STORAGE_DIR=.storage

# S3 driver only:
S3_BUCKET=mnm-fashion-invoices
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional custom endpoint for MinIO / Cloudflare R2 / DigitalOcean Spaces:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true   # required for MinIO

# Rate limiting (requests / window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000

# Shop details (printed on the GST tax invoice)
SHOP_NAME=MNM Fashion
SHOP_ADDRESS=Shop No 10, Priyanka Market, Wagholi, Pune. 412207
SHOP_PHONE=8208683401
SHOP_GSTIN=27CIHPN3553N1ZP
SHOP_EMAIL=
SHOP_STATE=Maharashtra
SHOP_STATE_CODE=27
# Bank details printed on the invoice
SHOP_BANK_NAME=ICICI BANK
SHOP_BANK_ACCOUNT=239005003473
SHOP_BANK_IFSC=ICIC0002390
# Default HSN code when a product has none
SHOP_DEFAULT_HSN=6209

# Coded price printed on product tags/labels (keeps the real price obscured).
# Final code = <YY> + MID + price(left-padded to PAD) + SUFFIX
# where YY = current year's last 2 digits (ONLY this rolls each year); MID + SUFFIX stay fixed.
# Example (2026): 26 + 271008 + 1200 + 23 = 26271008120023  (2027 → 27271008120023)
PRICE_CODE_MID=271008
PRICE_CODE_SUFFIX=23
PRICE_CODE_PAD=4
# Optional: pin the year instead of using the current one (2- or 4-digit), e.g. 2026
# PRICE_CODE_YEAR=2026
