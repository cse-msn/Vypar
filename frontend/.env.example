# MNM Fashion — Frontend environment
# Copy to `.env` (or `.env.local`) for local development.

# Base URL of the backend REST API.
# In dev, Vite proxies "/api" to the backend, so the default is fine.
VITE_API_BASE_URL=/api

# Shop display name (used in UI headers / fallbacks)
VITE_APP_NAME=MNM Fashion
